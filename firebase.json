{
  "hosting": [
    {
      "site": "tapcafe",
      "public": ".",
      "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/.*/**", "serve.ps1", "README.md", "tools/**", "node_modules/**"],
      "headers": [
        { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    },
    {
      "site": "tapcafe-game",
      "public": ".",
      "ignore": ["**/*"],
      "redirects": [
        { "source": "**", "destination": "https://tapcafe.web.app/", "type": 301 }
      ]
    }
  ]
}
